<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fondo del Spinner -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white"/> <!-- Color de fondo -->
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- Borde blanco -->
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/> <!-- Transparente para solo mostrar el borde -->
            <stroke android:width="2dp" android:color="@android:color/white"/> <!-- Borde blanco -->
            <corners android:radius="12dp"/>
        </shape>
    </item>

</layer-list>
